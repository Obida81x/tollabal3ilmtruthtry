# ======================================================
# متغيرات البيئة — انسخها في Render Dashboard
# ======================================================

# قاعدة البيانات (Neon)
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# الجلسات — Render يولّدها تلقائياً إذا كتبت generateValue: true
SESSION_SECRET=change_this_to_a_very_long_random_string_minimum_32_chars

# البيئة — مهم جداً
NODE_ENV=production

# Render يستخدم PORT=10000 تلقائياً، لا تغيّره
PORT=10000

# كلمة سر لوحة الأدمن
ADMIN_PANEL_PASSWORD=your_strong_password_here

# رابط الفرونت إند على Vercel
CORS_ORIGIN=https://your-app-name.vercel.app

# SendGrid للإيميل (اختياري)
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
